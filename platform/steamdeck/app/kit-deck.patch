+    // RommDeck: where r lands on the canvas, under the current transform and
+    // cut to the clip in force (an empty rectangle when the clip hides it).
+    // The touch screen's hit zones are these.
+    Rect on_canvas(const Rect &r) const
+    {
+        Rect a = apply(r);
+        if (clips_.empty())
+            return a;
+        const Rect &c = clips_.back();
+        const float x0 = a.x > c.x ? a.x : c.x, y0 = a.y > c.y ? a.y : c.y;
+        const float x1 = a.x + a.w < c.x + c.w ? a.x + a.w : c.x + c.w;
+        const float y1 = a.y + a.h < c.y + c.h ? a.y + a.h : c.y + c.h;
+        return {x0, y0, x1 > x0 ? x1 - x0 : 0.0f, y1 > y0 ? y1 - y0 : 0.0f};
+    }
 
